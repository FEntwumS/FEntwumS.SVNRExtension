<?xml version="1.0" encoding="utf-8"?>
<!--
    Solange der Feature-Branch gdb-debugger-integration nicht gemergt ist, gibt es die
    Debugger-Vertraege (IDebuggerService, DebugLaunchRequest) nur im eigenen Fork und nicht
    im veroeffentlichten OneWare.Essentials. Siehe DESIGN.local.md, Befund D-3.

    Erzeugt wird das lokale Paket mit:
        dotnet pack ..\oneware\src\OneWare.Essentials\OneWare.Essentials.csproj `
            -c Release -o ..\local-nuget -p:Version=1.0.99-svnrlocal

    Der Pfad ist relativ zu dieser Datei; beide Repos muessen also nebeneinander liegen.
-->
<configuration>
    <packageSources>
        <add key="oneware-local" value="..\local-nuget"/>
    </packageSources>
</configuration>
