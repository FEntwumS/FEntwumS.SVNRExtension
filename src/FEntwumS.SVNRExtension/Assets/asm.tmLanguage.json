{
  "scopeName": "source.asm",
  "name": "ASM",
  "fileTypes": [
    "asm"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#commands"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.asm",
          "match": "^\\s*[;].*$"
        },
        {
          "name": "comment.line.hash.asm",
          "match": "^\\s*#.*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.free-lines.asm",
          "match": "^\\s*@FreeLines\\s*$"
        }
      ]
    },
    "commands": {
      "patterns": [
        {
          "name": "meta.command.pattern1.asm",
          "match": "^(([0-9A-Fa-f]{1,4})|(.{1,4})):\\s*([0-9A-Fa-f]{4})\\s*((#|;).*)?$",
          "captures": {
            "2": { "name": "constant.numeric.address.asm" },
            "3": { "name": "invalid.illegal.asm" },
            "4": { "name": "variable.hex.data.asm" },
            "5": { "name": "comment.line.hash.asm" }
          }
        },
        {
          "name": "meta.command.pattern2.asm",
          "match": "^(([0-9A-Fa-f]{1,4})|(.{1,4})):\\s*((NOOP|LDM|LDI|LDA|STI|STM|ADD|SUB|AND|OR|NOT|XOR|INC|DEC|LEFT|RIGT|JM|JA|JZM|JNM|JLM|JZA|JNA|JLA|IN|OUT)|(.{2,4}))\\s*(([0-9A-Fa-f]{2})|(.{1,3}))\\s*((#|;).*)?$",
          "captures": {
            "2": { "name": "constant.numeric.address.asm" },
            "3": { "name": "invalid.illegal.asm" },
            "5": { "name": "keyword.language.asm" },
            "6": { "name": "invalid.illegal.asm" },
            "8": { "name": "variable.hex.data.asm" },
            "9": { "name": "invalid.illegal.asm" },
            "10": { "name": "comment.line.hash.asm" }
          }
        }
      ]
    }
  }
}