<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Version>0.4.9</Version>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <SelfContained>false</SelfContained>
        <RootNamespace>FEntwumS.SVNRExtension</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\asm.tmLanguage.json"/>
        <Content Include="Assets\template.o">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Assets\target.xml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <!-- Serielle Verbindung zum FPGA (SBDP-2). Kein Teil des Shared Framework, muss also mit
             ausgeliefert werden - daher Private="true". Das Metadatum ist ausserdem Pflicht:
             GenerateCompatibilityFile wertet %(Private) ueber alle PackageReference aus und
             bricht ab, sobald eines es nicht setzt. -->
        <PackageReference Include="System.IO.Ports" Version="10.0.0" Private="true" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="OneWare.GhdlExtension" Version="1.0.4" Private="true" ExcludeAssets="runtime;Native" />
        <PackageReference Include="OneWare.Essentials" Version="1.0.27.1" Private="false" ExcludeAssets="runtime;Native" />
        <PackageReference Include="OneWare.OssCadSuiteIntegration" Version="1.0.27.1" Private="false" ExcludeAssets="runtime;Native" />
        <PackageReference Include="OneWare.UniversalFpgaProjectSystem" Version="1.0.27.1" Private="false" ExcludeAssets="runtime;Native" />
    </ItemGroup>

    <Target Name="GenerateCompatibilityFile" AfterTargets="Build">
        <ItemGroup>
            <FilteredDependencies Include="@(PackageReference)" Condition="'%(Private)' == 'false'"/>
        </ItemGroup>
        
        <WriteLinesToFile
                File="$(OutDir)compatibility.txt"
                Lines="@(FilteredDependencies->'%(Identity) : %(Version)')"
                Overwrite="true"/>
    </Target>

</Project>
